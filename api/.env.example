# Copy to api/.env and fill in real values. Never commit api/.env.
# Local dev (Postgres running on localhost):
DATABASE_URL=postgresql://learn:CHOOSE_A_STRONG_PASSWORD@localhost:5432/learn
# A long random string, e.g. from: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHOOSE_A_LONG_RANDOM_SECRET_KEY
# Comma-separated origins allowed to call the API directly, e.g.:
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
