# Copy to .env at the repo root before `docker compose up --build`.
# Never commit .env.
# A strong password for the Postgres user `learn`:
POSTGRES_PASSWORD=CHOOSE_A_STRONG_PASSWORD
# A long random string, e.g. from: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHOOSE_A_LONG_RANDOM_SECRET_KEY
